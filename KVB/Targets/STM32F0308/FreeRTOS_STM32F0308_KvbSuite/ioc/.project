<?xml version="1.0" encoding="UTF-8"?>
<projectDescription>
	<name>FreeRTOS_STM32F0308_KvbSuite</name>
	<comment>KVB benchmark suite on FreeRTOS for STM32F0308-DISCO board.  Sibling of TaktOS_STM32F0308_KvbSuite — same shared platform/test set, FreeRTOS swapped for TaktOS as the kernel under test.</comment>
	<projects>
	</projects>
	<buildSpec>
		<buildCommand>
			<name>org.eclipse.cdt.managedbuilder.core.genmakebuilder</name>
			<triggers>clean,full,incremental,</triggers>
			<arguments>
			</arguments>
		</buildCommand>
		<buildCommand>
			<name>org.eclipse.cdt.managedbuilder.core.ScannerConfigBuilder</name>
			<triggers>full,incremental,</triggers>
			<arguments>
			</arguments>
		</buildCommand>
	</buildSpec>
	<natures>
		<nature>org.eclipse.cdt.core.cnature</nature>
		<nature>org.eclipse.cdt.core.ccnature</nature>
		<nature>org.eclipse.cdt.managedbuilder.core.managedBuildNature</nature>
		<nature>org.eclipse.cdt.managedbuilder.core.ScannerConfigNature</nature>
	</natures>
	<linkedResources>
		<link>
			<name>src</name>
			<type>2</type>
			<locationURI>virtual:/virtual</locationURI>
		</link>

		<!-- Per-MCU shared (PARENT-2 = KVB/Targets/STM32F0308/) -->
		<link>
			<name>src/board.h</name>
			<type>1</type>
			<locationURI>PARENT-2-PROJECT_LOC/include/board.h</locationURI>
		</link>
		<link>
			<name>src/FreeRTOSConfig.h</name>
			<type>1</type>
			<locationURI>PARENT-2-PROJECT_LOC/include/FreeRTOSConfig.h</locationURI>
		</link>
		<link>
			<name>src/kvb_platform_stm32f0308.cpp</name>
			<type>1</type>
			<locationURI>PARENT-2-PROJECT_LOC/src/kvb_platform_stm32f0308.cpp</locationURI>
		</link>

		<!-- Targets-tree shared (PARENT-3 = KVB/Targets/) -->
		<link>
			<name>src/main.cpp</name>
			<type>1</type>
			<locationURI>PARENT-3-PROJECT_LOC/src/main.cpp</locationURI>
		</link>
		<link>
			<name>src/kvb_platform_iosonata.cpp</name>
			<type>1</type>
			<locationURI>PARENT-3-PROJECT_LOC/src/kvb_platform_iosonata.cpp</locationURI>
		</link>
		<link>
			<name>src/kvb_freertos_hooks.c</name>
			<type>1</type>
			<locationURI>PARENT-3-PROJECT_LOC/src/kvb_freertos_hooks.c</locationURI>
		</link>

		<!-- KVB framework: core (PARENT-4 = KVB/) -->
		<link>
			<name>src/kvb_default_tests.c</name>
			<type>1</type>
			<locationURI>PARENT-4-PROJECT_LOC/src/core/kvb_default_tests.c</locationURI>
		</link>
		<link>
			<name>src/kvb_log.c</name>
			<type>1</type>
			<locationURI>PARENT-4-PROJECT_LOC/src/core/kvb_log.c</locationURI>
		</link>
		<link>
			<name>src/kvb_platform_default.c</name>
			<type>1</type>
			<locationURI>PARENT-4-PROJECT_LOC/src/core/kvb_platform_default.c</locationURI>
		</link>
		<link>
			<name>src/kvb_registry.c</name>
			<type>1</type>
			<locationURI>PARENT-4-PROJECT_LOC/src/core/kvb_registry.c</locationURI>
		</link>
		<link>
			<name>src/kvb_result.c</name>
			<type>1</type>
			<locationURI>PARENT-4-PROJECT_LOC/src/core/kvb_result.c</locationURI>
		</link>
		<link>
			<name>src/kvb_runner.c</name>
			<type>1</type>
			<locationURI>PARENT-4-PROJECT_LOC/src/core/kvb_runner.c</locationURI>
		</link>

		<!-- KVB framework: tests -->
		<link>
			<name>src/kvb_test_sched.c</name>
			<type>1</type>
			<locationURI>PARENT-4-PROJECT_LOC/src/tests/sched/kvb_test_sched.c</locationURI>
		</link>
		<link>
			<name>src/kvb_test_sync.c</name>
			<type>1</type>
			<locationURI>PARENT-4-PROJECT_LOC/src/tests/sync/kvb_test_sync.c</locationURI>
		</link>
		<link>
			<name>src/kvb_test_ipc.c</name>
			<type>1</type>
			<locationURI>PARENT-4-PROJECT_LOC/src/tests/ipc/kvb_test_ipc.c</locationURI>
		</link>
		<link>
			<name>src/kvb_test_time.c</name>
			<type>1</type>
			<locationURI>PARENT-4-PROJECT_LOC/src/tests/time/kvb_test_time.c</locationURI>
		</link>

		<!-- KVB framework: FreeRTOS port + Cortex-M platform layer -->
		<link>
			<name>src/kvb_port_freertos.c</name>
			<type>1</type>
			<locationURI>PARENT-4-PROJECT_LOC/ports/kernels/freertos/kvb_port_freertos.c</locationURI>
		</link>
		<link>
			<name>src/kvb_platform_cortex_m.c</name>
			<type>1</type>
			<locationURI>PARENT-4-PROJECT_LOC/ports/platforms/cortex_m/kvb_platform_cortex_m.c</locationURI>
		</link>

		<!-- FreeRTOS kernel — pulled from IOsonata's external/FreeRTOS-Kernel/.
		     Dynamic allocation build using heap_4 (4 KB) for the
		     diagnostic phase.  ARM_CM0 port. -->
		<link>
			<name>src/kernel</name>
			<type>2</type>
			<locationURI>virtual:/virtual</locationURI>
		</link>
		<link>
			<name>src/kernel/list.c</name>
			<type>1</type>
			<locationURI>IOCOMPOSER_HOME/external/FreeRTOS-Kernel/list.c</locationURI>
		</link>
		<link>
			<name>src/kernel/queue.c</name>
			<type>1</type>
			<locationURI>IOCOMPOSER_HOME/external/FreeRTOS-Kernel/queue.c</locationURI>
		</link>
		<link>
			<name>src/kernel/tasks.c</name>
			<type>1</type>
			<locationURI>IOCOMPOSER_HOME/external/FreeRTOS-Kernel/tasks.c</locationURI>
		</link>
		<!-- Virtual folder chain mirroring FreeRTOS-Kernel/portable/GCC/ARM_CM0
		     inside the project.  Replicates the layout used by the working
		     FreeRTOS_nRF54L15_* TM projects.  Eclipse CDT requires every
		     parent virtual folder to be declared before nested links resolve.
		     A flat src/kernel/portasm.c link is silently ignored at managed-
		     build refresh, which is what produced the missing-symbol link
		     errors on the first attempt. -->
		<link>
			<name>src/kernel/portable</name>
			<type>2</type>
			<locationURI>virtual:/virtual</locationURI>
		</link>
		<link>
			<name>src/kernel/portable/GCC</name>
			<type>2</type>
			<locationURI>virtual:/virtual</locationURI>
		</link>
		<link>
			<name>src/kernel/portable/GCC/ARM_CM0</name>
			<type>2</type>
			<locationURI>virtual:/virtual</locationURI>
		</link>
		<link>
			<name>src/kernel/portable/GCC/ARM_CM0/port.c</name>
			<type>1</type>
			<locationURI>IOCOMPOSER_HOME/external/FreeRTOS-Kernel/portable/GCC/ARM_CM0/port.c</locationURI>
		</link>
		<link>
			<name>src/kernel/portable/GCC/ARM_CM0/portasm.c</name>
			<type>1</type>
			<locationURI>IOCOMPOSER_HOME/external/FreeRTOS-Kernel/portable/GCC/ARM_CM0/portasm.c</locationURI>
		</link>
		<!-- Virtual folder for portable/MemMang to host heap_4.c, mirroring
		     the FreeRTOS-Kernel directory layout.  Required because Eclipse
		     CDT silently drops flat src/kernel/heap_4.c links once the
		     nested src/kernel/portable virtual folder exists. -->
		<link>
			<name>src/kernel/portable/MemMang</name>
			<type>2</type>
			<locationURI>virtual:/virtual</locationURI>
		</link>
		<link>
			<name>src/kernel/portable/MemMang/heap_4.c</name>
			<type>1</type>
			<locationURI>IOCOMPOSER_HOME/external/FreeRTOS-Kernel/portable/MemMang/heap_4.c</locationURI>
		</link>
	</linkedResources>
</projectDescription>
