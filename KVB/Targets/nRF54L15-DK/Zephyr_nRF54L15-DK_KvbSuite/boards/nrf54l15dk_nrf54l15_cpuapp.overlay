/* SPDX-License-Identifier: MIT
 *
 * Devicetree overlay for the KVB benchmark on nRF54L15-DK.
 *
 * The default board devicetree
 * (zephyr/boards/nordic/nrf54l15dk/nrf54l15dk_nrf54l15_cpuapp.dts)
 * already routes the Zephyr console to uart30, which on the nRF54L15-DK
 * appears as the J-Link CDC ACM virtual COM port over the IMCU USB
 * connector.  KVB's printk-based log output goes there directly with
 * no overlay required.
 *
 * This file is kept as an empty stub so that future KVB additions
 * (extra GPIOs for benchmark instrumentation, alternative UART pin
 * routing, etc.) have a documented home and don't get scattered
 * across prj.conf and source files.
 */

/ {
    /* No overrides required.  The board defconfig + DTS provides
     * everything KVB needs:
     *
     *   chosen { zephyr,console = &uart30; ... }
     *
     * which the prj.conf CONFIG_UART_CONSOLE=y selects automatically.
     */
};
